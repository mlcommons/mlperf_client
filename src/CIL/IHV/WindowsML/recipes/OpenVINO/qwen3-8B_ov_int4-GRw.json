{
    "input_model": { "type": "HfModel", "model_path": "Qwen/Qwen3-8B" },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [ { "device":"gpu", "execution_providers": [ "OpenVINOExecutionProvider" ] } ]
        }
    },
    "passes": {
        "optimum_convert": {
            "type": "OpenVINOOptimumConversion",
            "extra_args": { 
                "device": "gpu",
                "task": "text-generation-with-past" 
            },
            "ov_quant_config": {
                "weight_format": "int4",
                "sym": false,
                "group_size": 128, 
                "ratio": 1.0,
                "awq": true,
                "scale_estimation": true,
                "dataset": "wikitext2"
            }
        },
        "io_update": { "type": "OpenVINOIoUpdate", "static": false, "reuse_cache": true },
        "encapsulation": {
            "type": "OpenVINOEncapsulation",
            "target_device": "gpu",
            "keep_ov_dynamic_dims": true,
            "ov_version": "2026.2",
            "reuse_cache": true
        }
    },
    "search_strategy": false,
    "target": "local_system",
    "cache_dir": "cache",
    "evaluate_input_model": false,
    "output_dir": "models_WindowsML/Qwen3-8B_windowsML-ov-int4-GRw"
}
