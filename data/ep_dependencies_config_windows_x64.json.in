    {
      "Name": "WindowsML",
      "Files": [
        { "Name": "DirectML.dll",                              "Path": "@MLPERF_WINML_PREFIX@/DirectML.dll" },
        { "Name": "Microsoft.Windows.AI.MachineLearning.dll",  "Path": "@MLPERF_WINML_PREFIX@/Microsoft.Windows.AI.MachineLearning.dll" },
        { "Name": "onnxruntime.dll",                           "Path": "@MLPERF_WINML_PREFIX@/onnxruntime.dll" },
        { "Name": "onnxruntime-genai.dll",                     "Path": "@MLPERF_WINML_PREFIX@/onnxruntime-genai.dll" },
        {
          "Name": "tensorrtrtx/onnxruntime-genai-cuda.dll",
          "Path": "@MLPERF_WINML_PREFIX@/tensorrtrtx/onnxruntime-genai-cuda.dll",
          "Condition": { "device_ep": "NvTensorRtRtx" }
        },
        {
          "Name": "tensorrtrtx/cudart64_12.dll",
          "Path": "@MLPERF_WINML_PREFIX@/tensorrtrtx/cudart64_12.dll",
          "Condition": { "device_ep": "NvTensorRtRtx" }
        }
      ]
    },
    {
      "Name": "Diffusers",
      "Dependencies": [
        { "Name": "RyzenAI-Runtime", "Condition": [ { "backend": "RYZENAI" }, { "device_vendor": "AMD" } ] }
      ],
      "Files": [
        @MLPERF_DIFFUSERS_FILES_JSON@
      ]
    }
  ]
}
