{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "SystemConfig": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "Comment",
          "TempPath",
          "EPDependenciesConfigPath",
          "BaseDir",
          "DownloadBehavior",
          "CacheLocalFiles",
          "PythonPath"
        ]
      },
      "properties": {
        "Comment": {
          "type": "string"
        },
        "TempPath": {
          "type": "string"
        },
        "EPDependenciesConfigPath": {
          "type": "string"
        },
        "BaseDir": {
          "type": "string"
        },
        "DownloadBehavior": {
          "type": "string",
          "enum": [
            "forced",
            "prompt",
            "skip_all",
            "deps_only",
            "normal"
          ]
        },
        "CacheLocalFiles": {
          "type": "boolean"
        },
        "PythonPath": {
          "type": "string"
        }
      },
      "required": [
        "TempPath"
      ]
    },
    "Scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "Name",
            "Models",
            "InputFilePath",
            "AssetsPath",
            "ResultsVerificationFile",
            "DataVerificationFile",
            "Iterations",
            "WarmUp",
            "Delay",
            "IsAgentic",
            "ToolsExecution",
            "ExecutionProviders"
          ]
        },
        "properties": {
          "Name": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "Models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ModelName": {
                  "type": "string"
                },
                "ModelBaseName": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "ModelDisplayName": {
                  "type": "string"
                },
                "FilePath": {
                  "type": "string",
                  "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                },
                "DataFilePath": {
                  "type": "string",
                  "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                },
                "TokenizerPath": {
                  "type": "string",
                  "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                }
              },
              "required": [
                "ModelName",
                "FilePath"
              ],
              "additionalProperties": {
                "type": "string",
                "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
              }
            },
            "minItems": 1
          },
          "DataPath": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
            },
            "minItems": 1
          },
          "AssetsPath": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
            },
            "minItems": 0
          },
          "ResultsVerificationFile": {
            "type": "string"
          },
          "DataVerificationFile": {
            "type": "string"
          },
          "Iterations": {
            "type": "integer",
            "minimum": 1
          },
          "WarmUp": {
            "type": "integer",
            "minimum": 0
          },
          "Delay": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "IsAgentic": {
            "type": "boolean"
          },
          "ToolsExecution": {
            "type": "boolean"
          },
          "ExecutionProviders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                  "type": "string",
                  "enum": [
                    "NativeOpenVINO",
                    "OrtGenAI",
                    "OrtGenAI-RyzenAI",
                    "llama-cpp",
                    "Vulkan",
                    "CUDA",
                    "Metal",
                    "NativeQNN",
                    "MLX",
                    "WindowsML",
                    "ROCm",
                    "Diffusers"
                  ]
                },
                "Config": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "Models": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "enum": [
                        "ModelName",
                        "ModelBaseName",
                        "ModelDisplayName",
                        "FilePath",
                        "DataFilePath",
                        "TokenizerPath"
                      ]
                    },
                    "properties": {
                      "ModelName": {
                        "type": "string"
                      },
                      "FilePath": {
                        "type": "string",
                        "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                      },
                      "DataFilePath": {
                        "type": "string",
                        "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                      },
                      "TokenizerPath": {
                        "type": "string",
                        "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                      }
                    },
                    "required": [
                      "ModelName"
                    ]
                  },
                  "minItems": 0
                },
                "additionalProperties": false
              },
              "required": [
                "Name",
                "Config"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "Name": {
                        "const": "NativeOpenVINO"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "Config": {
                        "type": "object",
                        "properties": {
                          "device_type": {
                            "type": "string",
                            "enum": [
                              "GPU",
                              "NPU"
                            ]
                          },
                          "num_of_threads": {
                            "type": "integer",
                            "minimum": -1
                          },
                          "num_streams": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [ "device_type" ]
                      }
                    },
                    "LibraryPath": {
                      "type": "string"
                    },
                    "required": [
                      "Config"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "Name": {
                        "const": "OrtGenAI"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "Config": {
                        "type": "object",
                        "properties": {
                          "device_type": {
                            "type": "string",
                            "enum": [
                              "GPU",
                              "NPU"
                            ]
                          }
                        }
                      }
                    },
                    "LibraryPath": {
                      "type": "string"
                    },
                    "required": [
                      "Config"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "Name": {
                        "const": "OrtGenAI-RyzenAI"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "Config": {
                        "type": "object",
                        "properties": {
                          "device_type": {
                            "type": "string",
                            "enum": [
                              "NPU and GPU",
                              "NPU"
                            ]
                          }
                        }
                      }
                    },
                    "LibraryPath": {
                      "type": "string"
                    },
                    "required": [
                      "Config"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "Name": {
                        "const": "WindowsML"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "Config": {
                        "type": "object",
                        "properties": {
                          "device_type": {
                            "type": "string",
                            "enum": [
                              "GPU",
                              "NPU"
                            ]
                          }
                        }
                      }
                    },
                    "LibraryPath": {
                      "type": "string"
                    },
                    "required": [
                      "Config"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "Name": {
                        "const": "llama-cpp"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "Config": {
                        "type": "object",
                        "properties": {
                          "backend": {
                            "type": "string",
                            "enum": [
                              "Vulkan",
                              "Metal",
                              "CUDA",
                              "ROCm"
                            ]
                          },
                          "device_type": {
                            "type": "string",
                            "enum": [
                              "GPU",
                              "CPU"
                            ]
                          },
                          "device_vendor": {
                            "type": "string"
                          },
                          "device_id": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "gpu_layers": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "fa": {
                            "type": "integer"
                          },
                          "no_mmap": {
                            "type": "integer"
                          }
                        },
                        "required": [ "backend" ],
                        "additionalProperties": true
                      },
                      "LibraryPath": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "Config"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "Name": {
                        "const": "Diffusers"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "Config": {
                        "type": "object",
                        "properties": {
                          "backend": {
                            "type": "string",
                            "enum": [
                              "CUDA",
                              "MPS",
                              "RYZENAI"
                            ]
                          },
                          "device_type": {
                            "type": "string",
                            "enum": [
                              "GPU",
                              "NPU"
                            ]
                          },
                          "device_id": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "optimizations": {
                            "type": "array",
                            "items": {
                              "oneOf": [
                                { "type": "string" },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": { "type": "string" }
                                  },
                                  "required": ["type"],
                                  "additionalProperties": true
                                }
                              ]
                            }
                          }
                        },
                        "required": ["backend"],
                        "additionalProperties": true
                      },
                      "LibraryPath": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "Config"
                    ]
                  }
                }
              ]
            }
          }
        },
        "required": [
          "Name",
          "Models",
          "InputFilePath",
          "AssetsPath",
          "DataVerificationFile",
          "ResultsVerificationFile",
          "Iterations",
          "ExecutionProviders"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "Name": { "pattern": "^[Tt][Xx][Tt]2[Tt][Xx][Tt]$" }
              },
              "required": [ "Name" ]
            },
            "then": {
              "properties": {
                "Models": {
                  "items": {
                    "required": [ "ModelName", "FilePath", "ModelBaseName" ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "Name": { "pattern": "^[Tt][Xx][Tt]2[Ii][Mm][Gg]$" }
              },
              "required": [ "Name" ]
            },
            "then": {
              "properties": {
                "Models": {
                  "items": {
                    "required": [ "ModelName", "FilePath", "ModelBaseName" ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "SystemConfig",
    "Scenarios"
  ],
  "additionalProperties": false
}
