{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "conditionClause": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/definitions/conditionClause" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/conditionClause" }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "EPDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                    "type": "string"
                },
                "Path": {
                    "type": "string",
                    "pattern": "^(file:\\/\\/|http:\\/\\/|https:\\/\\/)"
                },
                "Condition": { "$ref": "#/definitions/condition" }
              },
              "required": ["Name", "Path"],
              "additionalProperties": false
            }
          },
          "Dependencies": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "Name": { "type": "string" },
                    "Condition": { "$ref": "#/definitions/condition" }
                  },
                  "required": ["Name"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["Name", "Files"],
        "additionalProperties": false
      }
    }
  },
  "required": ["EPDependencies"],
  "additionalProperties": false
}
