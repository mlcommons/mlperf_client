{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "model_config": {
      "properties": {
        "context_length": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "properties": {
            "bos_token_id": {
              "type": "integer"
            },
            "eos_token_id": {
              "type": "integer"
            },
            "vocab_size": {
              "type": "integer",
              "minimum": 1
            },
            "context_length": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "search": {
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "greedy",
                "top_k",
                "top_p"
              ]
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "top_k": {
              "type": "integer",
              "minimum": 1
            },
            "top_p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "stop_on_eos": {
              "type": "boolean"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_length": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      },
      "required": [
        "search"
      ]
    },
    "prompts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "system": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "assistant": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "enable_thinking": {
                "type": "boolean"
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        ]
      }
    },
    "category": {
      "type": "string"
    },
    "apply_chat_template": {
      "type": "boolean",
      "default": false
    },
    "enable_thinking": {
      "type": "boolean"
    },
    "prompt_files": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "model_config",
    "prompts"
  ],
  "additionalProperties": false
}
