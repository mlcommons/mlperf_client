{
  "npu_bin_pattern": "llama3_npu_*.bin",
  "dialog": {
    "version": 1,
    "type": "basic",
    "stop-sequence": [""],
    "engine": {
      "version": 1,
      "n-threads": 3,
      "backend": {
        "version": 1,
        "type": "QnnHtp",
        "QnnHtp": {
          "version": 1,
          "spill-fill-bufsize": 0,
          "use-mmap": false,
          "mmap-budget": 0,
          "poll": false,
          "pos-id-dim": 64,
          "cpu-mask": "0xe0",
          "kv-dim": 128,
          "rope-theta": 500000
        },
        "extensions": "${MODEL_FOLDER}/htp_backend_ext_config_npu.json"
      },
      "model": {
        "version": 1,
        "type": "binary",
        "binary": {
          "version": 1,
          "ctx-bins": "${NPU_BINS}"
        }
      }
    },
    "context": {
      "version": 1,
      "n-vocab": 128256,
      "bos-token": -1,
      "eos-token": [128001, 128008, 128009]
    },
    "sampler": {
      "version": 1,
      "seed": 100,
      "greedy": true
    },
    "tokenizer": {
      "version": 1,
      "path": "${MODEL_FOLDER}/tokenizer.json"
    }
  }
}
