{
  "EPDependencies": [
    {
      "Name": "NativeQNN",
      "Files": [
        { "Name": "Genie.dll",                       "Path": "@MLPERF_NATIVE_QNN_PREFIX@/Genie.dll" },
        { "Name": "QnnHtp.dll",                      "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnHtp.dll" },
        { "Name": "QnnHtpNetRunExtensions.dll",      "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnHtpNetRunExtensions.dll" },
        { "Name": "QnnSystem.dll",                   "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnSystem.dll" },
        { "Name": "QnnHtpV73Stub.dll",               "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnHtpV73Stub.dll" },
        { "Name": "libQnnHtpV73Skel.so",             "Path": "@MLPERF_NATIVE_QNN_PREFIX@/libQnnHtpV73Skel.so" },
        { "Name": "libqnnhtpv73.cat",                "Path": "@MLPERF_NATIVE_QNN_PREFIX@/libqnnhtpv73.cat" },
        { "Name": "QnnGenAiTransformerModel.dll",    "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnGenAiTransformerModel.dll" },
        { "Name": "QnnGenAiTransformer.dll",         "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnGenAiTransformer.dll" },
        { "Name": "QnnHtpV81Stub.dll",               "Path": "@MLPERF_NATIVE_QNN_PREFIX@/QnnHtpV81Stub.dll" },
        { "Name": "libQnnHtpV81Skel.so",             "Path": "@MLPERF_NATIVE_QNN_PREFIX@/libQnnHtpV81Skel.so" },
        { "Name": "libqnnhtpv81.cat",                "Path": "@MLPERF_NATIVE_QNN_PREFIX@/libqnnhtpv81.cat" }
      ]
    },
    {
      "Name": "WindowsML",
      "Files": [
        { "Name": "DirectML.dll",                              "Path": "@MLPERF_WINML_PREFIX@/DirectML.dll" },
        { "Name": "Microsoft.Windows.AI.MachineLearning.dll",  "Path": "@MLPERF_WINML_PREFIX@/Microsoft.Windows.AI.MachineLearning.dll" },
        { "Name": "onnxruntime.dll",                           "Path": "@MLPERF_WINML_PREFIX@/onnxruntime.dll" },
        { "Name": "onnxruntime-genai.dll",                     "Path": "@MLPERF_WINML_PREFIX@/onnxruntime-genai.dll" },
        {
          "Name": "tensorrtrtx/onnxruntime-genai-cuda.dll",
          "Path": "@MLPERF_WINML_PREFIX@/tensorrtrtx/onnxruntime-genai-cuda.dll",
          "Condition": { "device_ep": "NvTensorRtRtx" }
        }
      ]
    },
    {
      "Name": "llama-cpp",
      "Files": [
        { "Name": "cudart64_13.dll",   "Path": "@MLPERF_CUDA_PREFIX@/cudart64_13.dll",   "Condition": { "backend": "CUDA" } },
        { "Name": "cublas64_13.dll",   "Path": "@MLPERF_CUDA_PREFIX@/cublas64_13.dll",   "Condition": { "backend": "CUDA" } },
        { "Name": "cublasLt64_13.dll", "Path": "@MLPERF_CUDA_PREFIX@/cublasLt64_13.dll", "Condition": { "backend": "CUDA" } },
        { "Name": "libomp140.aarch64.dll", "Path": "@MLPERF_CUDA_PREFIX@/libomp140.aarch64.dll", "Condition": { "backend": "CUDA" } }
      ]
    },
    {
      "Name": "Diffusers",
      "Files": [
        @MLPERF_DIFFUSERS_FILES_JSON@
      ]
    }
  ]
}
