    },
    {
      "Name": "OrtGenAI-RyzenAI",
      "Dependencies": ["RyzenAI-Runtime"],
      "Files": [
        { "Name": "onnxruntime-genai.dll",              "Path": "@MLPERF_ORTGENAI_RYZENAI_PREFIX@/onnxruntime-genai.dll" }
      ]
    },
    {
      "Name": "llama-cpp",
      "Files": [
        { "Name": "cudart64_13.dll",   "Path": "@MLPERF_CUDA_PREFIX@/cudart64_13.dll",  "Condition": { "backend": "CUDA" } },
        { "Name": "cublas64_13.dll",   "Path": "@MLPERF_CUDA_PREFIX@/cublas64_13.dll",  "Condition": { "backend": "CUDA" } },
        { "Name": "cublasLt64_13.dll", "Path": "@MLPERF_CUDA_PREFIX@/cublasLt64_13.dll","Condition": { "backend": "CUDA" } }
      ]
    },
    {
      "Name": "NativeQNN",
      "Files": [
        { "Name": "Genie.dll",                       "Path": "@MLPERF_NATIVE_QNN_PREFIX@/Genie.dll" },
