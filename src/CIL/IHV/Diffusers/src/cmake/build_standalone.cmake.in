# Auto-generated by configure_file(); do not edit manually.
# Driver for the diffusers_standalone target. Skips when the script+spec
# digest matches the .standalone_built sentinel.

set(_python_exe   "@_PY_EXE@")
set(_spec         "@STANDALONE_SPEC@")
set(_tools_dir    "@STANDALONE_TOOLS_DIR@")
set(_scripts_dir  "@STANDALONE_SCRIPTS_DIR@")
set(_output_dir   "@INSTALL_PREFIX@")
set(_workpath     "@STANDALONE_WORKPATH@")
set(_sentinel     "@INSTALL_PREFIX@/.standalone_built")
set(_specs_dir    "${_tools_dir}/specs")

if(NOT EXISTS "${_python_exe}")
    message(FATAL_ERROR
        "Embedded Python not found at ${_python_exe}.\n"
        "Configure with -DMLPERF_IHV_DIFFUSERS_INSTALL_PYTHON=ON and run "
        "cmake --install for the Diffusers EP first to populate it.")
endif()

file(GLOB_RECURSE _script_files "${_scripts_dir}/*.py")
file(GLOB _spec_snippets "${_specs_dir}/*.py")
list(APPEND _script_files ${_spec_snippets})
list(SORT _script_files)
set(_digest_concat "")
foreach(_f IN LISTS _script_files)
    file(SHA256 "${_f}" _h)
    string(APPEND _digest_concat "${_h}")
endforeach()
file(SHA256 "${_spec}" _h)
string(APPEND _digest_concat "${_h}")
string(SHA256 _inputs_digest "${_digest_concat}")

set(_sentinel_digest "")
if(EXISTS "${_sentinel}")
    file(READ "${_sentinel}" _sentinel_digest)
    string(STRIP "${_sentinel_digest}" _sentinel_digest)
endif()

set(_bundle_dir "${_output_dir}/standalone")
if(CMAKE_HOST_WIN32)
    set(_bundle_exe "${_bundle_dir}/diffusers_standalone.exe")
else()
    set(_bundle_exe "${_bundle_dir}/diffusers_standalone")
endif()

if(_sentinel_digest STREQUAL _inputs_digest
        AND EXISTS "${_bundle_exe}"
        AND EXISTS "${_bundle_dir}/_internal")
    message(STATUS "Diffusers standalone bundle up to date (digest matches), skipping.")
    return()
endif()

if(_sentinel_digest STREQUAL "")
    message(STATUS "Building Diffusers PyInstaller standalone bundle (no sentinel)...")
elseif(NOT _sentinel_digest STREQUAL _inputs_digest)
    message(STATUS "Rebuilding Diffusers PyInstaller standalone bundle (script/spec digest changed)...")
else()
    message(STATUS "Rebuilding Diffusers PyInstaller standalone bundle (bundle missing or incomplete)...")
endif()

execute_process(
    COMMAND "${_python_exe}" -I -m PyInstaller
            --noconfirm --clean
            --workpath "${_workpath}"
            --distpath "${_output_dir}"
            "${_spec}"
    RESULT_VARIABLE _pyi_result
    WORKING_DIRECTORY "${_tools_dir}")

if(NOT _pyi_result EQUAL 0)
    message(FATAL_ERROR "PyInstaller build failed (rc=${_pyi_result})")
endif()

get_filename_component(_exe_name "${_bundle_exe}" NAME)
file(REMOVE "${_workpath}/standalone/${_exe_name}")

file(WRITE "${_sentinel}" "${_inputs_digest}")
message(STATUS "Diffusers standalone bundle built successfully.")
